body {
    font-family: 'Roboto', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #0d0d0d;
    color: #f5f5f5;
    line-height: 1.6;
}


header {
    background: #111;
    padding: 20px;
    text-align: center;
    border-bottom: 2px solid #e60000;
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
    color: #e60000;
    letter-spacing: 2px;
}


nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 30px;
    padding: 0;
    margin-top: 15px;
}

nav a {
    color: #f5f5f5;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s;
}

nav a:hover {
    color: #e60000;
}


.gallery {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.gallery img {
    width: 40%;
    border: 2px solid #e60000;
    border-radius: 5px;
    transition: transform 0.3s;
}

.gallery img:hover {
    transform: scale(1.05);
}


section {
    padding: 40px 20px;
    max-width: 900px;
    margin: auto;
}


footer {
    background: #111;
    text-align: center;
    padding: 15px;
    border-top: 2px solid #e60000;
    font-size: 0.9rem;
}

.Steam{
  text-decoration: none;
  font-weight: bold;
  font-size: 40 px;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 20px;
  transition: transform 0.3s;
}

.Steam:hover{
  color: red;
  font-size: 50 px;
      transform: scale(1.2);

}

@media (max-width: 768px) {
    .gallery img {
        width: 80%;
    }
}
